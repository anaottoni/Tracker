<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#22000000">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="0"
                android:endColor="@color/laranja"
                android:startColor="@color/roxo_letra"
                android:type="linear" />
        </shape>
    </item>
    <!-- Camada interna branca para deixar apenas a borda aparente -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/branco" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</ripple>