<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Tracker" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
    </style>

    <style name="BACKGROUND">
        <item name="android:background">@color/roxo_medio</item>
    </style>

    <style name="MENU">
        <item name="android:background">@color/roxo_escuro</item>
        <item name="android:textColor">@color/branco</item>
    </style>

    <style name="SettingsPopUp" parent="ThemeOverlay.MaterialComponents.Toolbar.Surface">
        <!-- 1. Força a caixinha a abrir ABAIXO do botão (sem cobri-lo) -->
        <item name="overlapAnchor">false</item>
        <item name="android:overlapAnchor">false</item>

        <!-- 2. Cor de fundo do menu -->
        <item name="android:popupBackground">#A58CA3</item>
        <item name="colorSurface">#A58CA3</item>

        <!-- 3. Cor do texto dos itens do menu -->
        <item name="android:textColor">@color/branco</item>
        <item name="colorOnSurface">@color/branco</item>

        <!-- 4. Espaçamento/Ajuste vertical extra (opcional) -->
        <item name="android:dropDownVerticalOffset">4dp</item>
    </style>
</resources>